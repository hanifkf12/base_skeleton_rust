APP_HOST=0.0.0.0
APP_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_skeleton
# Optional privileged migration connection. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_SECONDS=3
USER_CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=65536
JOB_POLL_INTERVAL_MILLISECONDS=1000
JOB_LEASE_TIMEOUT_SECONDS=300
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
JOB_MAX_ATTEMPTS=5
# Optional. A unique ID is generated when omitted.
JOB_WORKER_ID=
RUST_LOG=base_skeleton_rust=debug,tower_http=debug
