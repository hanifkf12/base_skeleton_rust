APP_HOST=0.0.0.0
APP_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_skeleton
# Optional privileged migration connection. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_SECONDS=3
USER_CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=65536
# Required only by the `http` and `all` commands. The issuer must expose OIDC discovery and JWKS.
OIDC_ISSUER_URL=http://localhost:8081/realms/demo
OIDC_AUDIENCE=base-skeleton-api
# Comma-delimited asymmetric JWT algorithms. Symmetric HMAC algorithms are rejected.
OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC provider calls use a fixed 5-second timeout. JWT validation allows 30 seconds of clock skew,
# and unknown-key JWKS refresh attempts are limited to one per 60 seconds per server instance.
JOB_POLL_INTERVAL_MILLISECONDS=1000
JOB_LEASE_TIMEOUT_SECONDS=300
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
JOB_MAX_ATTEMPTS=5
# Optional. A unique ID is generated when omitted.
JOB_WORKER_ID=
RUST_LOG=base_skeleton_rust=debug,tower_http=debug
# SigNoz OTLP/HTTP endpoint. For self-hosted SigNoz use http://localhost:4318.
# For SigNoz Cloud use the regional ingest endpoint, for example https://ingest.us.signoz.cloud:443.
OTEL_EXPORTER_OTLP_ENDPOINT=
# SigNoz Cloud only: signoz-ingestion-key=your-ingestion-key
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=base-skeleton-rust
